{
  "name": "quaymaster-net",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quaymaster: self-hosted Docker dashboard — .NET 10 backend, unchanged React frontend",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "web"
  ],
  "scripts": {
    "build": "npm run build -w shared && npm run build -w web",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w web",
    "lint": "eslint web shared && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test -w web"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
